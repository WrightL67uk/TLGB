# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Companies House REST API key (free): https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# SendGrid: API key with Mail Send permission, and a verified sender address
SENDGRID_API_KEY=
# (Optional while testing: leave SendGrid blank and the site runs without sending emails)
EMAIL_FROM=admin@tlgb.co.uk

# Who gets the "approval needed" emails (comma separated)

# Admin login for /admin (browser username/password prompt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

SITE_URL=http://localhost:3000

# Where replies to TLGB emails go (a real mailbox someone reads)
EMAIL_REPLY_TO=admin@tlgb.co.uk
# Shown in every email footer (helps with spam filters and is good practice)
BUSINESS_POSTAL_ADDRESS=
